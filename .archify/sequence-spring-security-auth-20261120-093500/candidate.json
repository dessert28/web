    {
      "dot": "emerald",
      "title": "认证 Authentication",
      "items": [
        "表单由 UsernamePasswordAuthenticationFilter 接收",
        "DaoAuthenticationProvider 调用 DataBaseUserDeatilsService",
        "账号与 BCrypt 哈希来自 sys_user，角色来自 sys_user_role"
      ]
    },
    {
      "dot": "violet",
      "title": "授权 Authorization",
      "items": [
        "SecurityContext 中的 Authentication 决定是否放行",
        "用户管理仅 ROLE_ADMIN，医生写操作 ADMIN/DOCTOR，浏览类三角色",
        "登录成功按角色跳转，避免跳到自己无权访问的页面"
      ]
    },
    {
      "dot": "rose",
      "title": "失败与越权",
      "items": [
        "未登录 → 302 /toLogin，登录失败 → /toLogin?error",
        "已登录但角色不足 → 403 AccessDenied",
        "不区分账号不存在与密码错误，避免账号枚举"
      ]
    }
  ]
