<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjsru.mapper.DoctorMapper">

    <!--
      javaweb 库的 doctor_info 没有 department 文本列，科室只存 department_id。
      所有查询都用 left join department 把 dept_name 取回来，别名成 Doctor.department，
      这样模板 doctorList.html / doctorQuery.html 里的 ${doctor.department} 不用改。
      显式写别名是因为没开 map-underscore-to-camel-case，department_id 不会自动映射到 departmentId。
    -->
    <sql id="doctorColumns">
        d.id, d.doctorName, d.gender, d.title, d.phone,
        d.department_id AS departmentId, dept.dept_name AS department
    </sql>

    <!-- 科室名称 → department.id：给只传科室名（不传 departmentId）的请求用 -->
    <select id="queryDepartmentIdByName" resultType="java.lang.Integer">
        select id from department where dept_name = #{deptName} limit 1
    </select>

    <select id="queryAllDoctors" resultType="Doctor">
        select <include refid="doctorColumns"/>
        from doctor_info d
        left join department dept on dept.id = d.department_id
        order by d.id
    </select>

    <!-- 单参数直接用 #{doctorid}，与方法参数名 doctorid 对应；改成多参数时必须加 @Param -->
    <select id="queryDoctorById" resultType="Doctor">
        select <include refid="doctorColumns"/>
        from doctor_info d
        left join department dept on dept.id = d.department_id
        where d.id = #{doctorid}
    </select>

    <!--
      新增医生：科室可以给 departmentId，也可以只给科室名 department。
      两者都没给时 department_id 为 NOT NULL 列会插入失败，所以控制器先挡一层。
      这里再加一次兜底子查询，保证只传科室名也能落库。
    -->
    <insert id="addDoctor" parameterType="Doctor">
        insert into doctor_info (doctorName, gender, phone, title, department_id)
        values (#{doctorName}, #{gender}, #{phone}, #{title},
        <choose>
            <when test="departmentId != null">#{departmentId}</when>
            <otherwise>(select id from department where dept_name = #{department} limit 1)</otherwise>
        </choose>
        )
    </insert>

    <!-- 多条件动态查询：姓名 / 科室 / 职称 三个条件全部留空时等于查全表 -->
    <select id="queryDoctorsByCondition" resultType="Doctor">
        select <include refid="doctorColumns"/>
        from doctor_info d
        left join department dept on dept.id = d.department_id
        <where>
            <if test="doctorName != null and doctorName != ''">
                d.doctorName like CONCAT('%', #{doctorName}, '%')
            </if>
            <if test="department != null and department != ''">
                and dept.dept_name like CONCAT('%', #{department}, '%')
            </if>
            <if test="title != null and title != ''">
                and d.title like CONCAT('%', #{title}, '%')
            </if>
        </where>
        order by d.id
    </select>

    <!-- 根据单个条件动态查询医生信息：choose 只取第一个成立的分支，
         姓名、科室都不填时走 otherwise，默认查主任医师 -->
    <select id="queryDoctorsBySingleCondition" resultType="Doctor">
        select <include refid="doctorColumns"/>
        from doctor_info d
        left join department dept on dept.id = d.department_id
        <where>
            <choose>
                <when test="doctorName != null and doctorName != ''">
                    d.doctorName like CONCAT('%', #{doctorName}, '%')
                </when>
                <when test="department != null and department != ''">
                    dept.dept_name like CONCAT('%', #{department}, '%')
                </when>
                <otherwise>
                    d.title = '主任医师'
                </otherwise>
            </choose>
        </where>
        order by d.id
    </select>

    <!-- 动态更新：<set> 会自动去掉末尾多余的逗号，
         只有传入的字段才参与 SET，没传的字段保持原值。
         科室与新增一致，支持传 departmentId 或传科室名 department。 -->
    <update id="updateDoctor" parameterType="Doctor">
        update doctor_info
        <set>
            <if test="doctorName != null and doctorName != ''">
                doctorName = #{doctorName},
            </if>
            <if test="gender != null and gender != ''">
                gender = #{gender},
            </if>
            <if test="title != null and title != ''">
                title = #{title},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="departmentId != null">
                department_id = #{departmentId},
            </if>
            <if test="departmentId == null and department != null and department != ''">
                department_id = (select id from department where dept_name = #{department} limit 1),
            </if>
        </set>
        where id = #{id}
    </update>

    <!-- 批量查询：<foreach> 拼出 id in (?,?,?)；
         集合为空时走 otherwise 的 1 = 2，保证 SQL 合法且返回空结果 -->
    <select id="queryDoctorsByIds" resultType="Doctor">
        select <include refid="doctorColumns"/>
        from doctor_info d
        left join department dept on dept.id = d.department_id
        <where>
            <choose>
                <when test="ids != null and ids.size() > 0">
                    d.id in
                    <foreach collection="ids" item="id" open="(" separator="," close=")">
                        #{id}
                    </foreach>
                </when>
                <otherwise>1 = 2</otherwise>
            </choose>
        </where>
        order by d.id
    </select>
</mapper>
