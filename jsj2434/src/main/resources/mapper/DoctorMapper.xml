<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjsru.mapper.DoctorMapper">
    <select id="queryAllDoctors" resultType="Doctor">
        select * from doctor_info
    </select>
    <select id="queryDoctorById"  resultType="Doctor">
        select * from doctor_info where id = #{doctorid}
    </select>
    <insert id="addDoctor" parameterType="Doctor">
        insert into doctor_info (doctorName, gender, phone, department, title)
        values (#{doctorName}, #{gender},  #{phone}, #{department}, #{title})
    </insert>
    <select id="queryDoctorsByCondition"  resultType="Doctor">
        select * from doctor_info
        <where>
            <if test="doctorName != null and doctorName != ''">
                doctorName like CONCAT('%', #{doctorName}, '%')
            </if>
            <if test="department != null and department != ''">
                and department like CONCAT('%', #{department}, '%')
            </if>
            <if test="title != null and title != ''">
                and title like CONCAT('%', #{title}, '%')
            </if>
        </where>
    </select>
    <!-- 根据单个条件动态查询医生信息：choose 只取第一个成立的分支，
         姓名、科室都不填时走 otherwise，默认查主任医师 -->
    <select id="queryDoctorsBySingleCondition" resultType="Doctor">
        select * from doctor_info
        <where>
            <choose>
                <when test="doctorName != null and doctorName != ''">
                    doctorName like CONCAT('%', #{doctorName}, '%')
                </when>
                <when test="department != null and department != ''">
                    department like CONCAT('%', #{department}, '%')
                </when>
                <otherwise>
                    title = '主任医师'
                </otherwise>
            </choose>
        </where>
    </select>
</mapper>