<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjsru.mapper.UserMapper">

    <!--
        1. resultType 指向项目里真实存在的类 com.zjsru.domain.Users
        2. sys_user 的启用字段叫 enabled，而 Users 属性叫 status，
           用别名 enabled as status 映射，否则 status 为 null，
           DataBaseUserDetailsService 里的 !user.getStatus() 会抛空指针
    -->
    <select id="findByUsername" resultType="com.zjsru.domain.Users">
        select id,
               username,
               password,
               enabled as status
        from sys_user
        where username = #{username}
    </select>

    <!--
        查询用户角色。sys_role 的真实列是 id、name（项目里没有 Role 类），
        而 DataBaseUserDetailsService 用 role.getUsername() 拼 "ROLE_" 前缀，
        因此这里把 r.name 别名为 username，Java 代码无需改动。
    -->
    <select id="findRolesByUserId" resultType="com.zjsru.domain.Users">
        select r.id,
               r.name as username
        from sys_user u
                 join sys_user_role ur on u.id = ur.user_id
                 join sys_role r on ur.role_id = r.id
        where u.id = #{id}
    </select>

</mapper>
